{
  "name": "icms-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --mode e2e",
    "dev:e2e-real": "vite --mode e2e-real",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.js",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.js --ui",
    "lint": "eslint src --ext .vue,.js --fix",
    "format": "eslint src --ext .vue,.js --fix"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@sentry/vue": "^10.63.0",
    "axios": "^1.18.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.2",
    "pinia": "^3.0.4",
    "sass": "^1.101.0",
    "vue": "^3.5.34",
    "vue-router": "^5.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@sentry/vite-plugin": "^5.3.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "eslint": "^10.5.0",
    "eslint-plugin-vue": "^10.9.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9"
  }
}
